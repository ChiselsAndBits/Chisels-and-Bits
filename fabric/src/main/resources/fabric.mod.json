{
  "schemaVersion": 1,
  "id": "$project.mod.id",
  "version": "$version",

  "name": "Chisels & Bits",
  "description": "$project.description",
  "authors": [
    "$project.author"
  ],

  "license": "$project.license",
  "icon": "logo.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "${project.package}.Fabric"
    ],
    "client": [
      "${project.package}.client.FabricClient"
    ]
  },
  "accessWidener" : "accesswidener.accesswidener",
  "mixins": [
    "chiselsandbits.mixins.json"
  ],

  "depends": {
    "fabricloader": "${dependencies.net.fabricmc.fabric.loader.npm}",
    "fabric-api": ">${dependencies.fabric.api.npm.get()}",
    "minecraft": [${minecraft.range.fabric.get()}],
    "java": ">=${java.version.get()}",
    "scena": "$dependencies.com.communi_suggestu.scena.fabric.npm"
  },
  "suggests": {
  }
}
